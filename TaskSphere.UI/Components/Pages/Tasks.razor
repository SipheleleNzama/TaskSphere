@page "/tasks"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using TaskSphere.Domain.Enums 
@using TaskStatus = TaskSphere.Domain.Enums.TaskStatus;

<MudText Typo="Typo.h3" Class="mb-4">My Tasks</MudText>

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect @bind-Value="selectedStatus" Label="Filter by Status" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem Value="@((TaskStatus?)null)">All</MudSelectItem>
                <MudSelectItem Value="@TaskStatus.ToDo">To Do</MudSelectItem>
                <MudSelectItem Value="@TaskStatus.InProgress">In Progress</MudSelectItem>
                <MudSelectItem Value="@TaskStatus.Done">Done</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog"
                       FullWidth="true">
                New Task
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (filteredTasks == null || !filteredTasks.Any())
{
    <MudPaper Elevation="0" Class="pa-8 text-center">
        <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Size="Size.Large" Color="Color.Default" Class="mb-4" />
        <MudText Typo="Typo.h6">No tasks found</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">Create your first task to get started</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog">
            Create Task
        </MudButton>
    </MudPaper>
}
else
{
    <MudTable Items="@filteredTasks" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
        <HeaderContent>
            <MudTh>Title</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Priority</MudTh>
            <MudTh>Due Date</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Title">
                <MudText Typo="Typo.body1">@context.Title</MudText>
                @if (!string.IsNullOrEmpty(context.Description))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@context.Description</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Status">
                <StatusChip Status="@context.Status" />
            </MudTd>
            <MudTd DataLabel="Priority">
                <MudChip T="string" Color="@GetPriorityColor(context.Priority)" Size="Size.Small">
                    @context.Priority
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Due Date">
                @if (context.DueDate.HasValue)
                {
                    <MudText>@context.DueDate.Value.ToString("MMM dd, yyyy")</MudText>
                }
                else
                {
                    <MudText Color="Color.Secondary">No due date</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                               Size="Size.Small" 
                               Color="Color.Primary"
                               OnClick="@(() => OpenEditDialog(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                               Size="Size.Small" 
                               Color="Color.Error"
                               OnClick="@(() => DeleteTask(context.Id))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<TaskDto> tasks = new();
    private List<TaskDto> filteredTasks = new();
    private TaskStatus? selectedStatus;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        isLoading = true;
        
        // Mock data for now - replace with API call
        await Task.Delay(500);
        tasks = new List<TaskDto>
        {
            new TaskDto 
            { 
                Id = 1, 
                Title = "Complete project documentation", 
                Description = "Write comprehensive docs",
                Status = TaskStatus.InProgress, 
                Priority = TaskPriority.High,
                DueDate = DateTime.Now.AddDays(3)
            },
            new TaskDto 
            { 
                Id = 2, 
                Title = "Review pull requests", 
                Status = TaskStatus.ToDo, 
                Priority = TaskPriority.Medium,
                DueDate = DateTime.Now.AddDays(1)
            },
            new TaskDto 
            { 
                Id = 3, 
                Title = "Deploy to production", 
                Status = TaskStatus.Done, 
                Priority = TaskPriority.High,
                DueDate = DateTime.Now.AddDays(-2)
            }
        };
        
        FilterTasks();
        isLoading = false;
    }

    private void FilterTasks()
    {
        filteredTasks = selectedStatus.HasValue 
            ? tasks.Where(t => t.Status == selectedStatus.Value).ToList()
            : tasks;
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<TaskDialog>("Create New Task");
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is TaskDto newTask)
        {
            tasks.Add(newTask);
            FilterTasks();
            Snackbar.Add("Task created successfully!", Severity.Success);
        }
    }

    private async Task OpenEditDialog(TaskDto task)
    {
        var parameters = new DialogParameters<TaskDialog>
        {
            { x => x.Task, task },
            { x => x.IsEdit, true }
        };

        var dialog = await DialogService.ShowAsync<TaskDialog>("Edit Task", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            FilterTasks();
            Snackbar.Add("Task updated successfully!", Severity.Success);
        }
    }

    private async Task DeleteTask(int id)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirm Delete",
            "Are you sure you want to delete this task?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            tasks.RemoveAll(t => t.Id == id);
            FilterTasks();
            Snackbar.Add("Task deleted successfully!", Severity.Success);
        }
    }

    private Color GetPriorityColor(TaskPriority priority) => priority switch
    {
        TaskPriority.High => Color.Error,
        TaskPriority.Medium => Color.Warning,
        TaskPriority.Low => Color.Info,
        _ => Color.Default
    };
}
