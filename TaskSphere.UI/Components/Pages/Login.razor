@page "/login"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Elevation="3" Class="pa-8">
        <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
            Welcome to TaskSphere
        </MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6">
            Sign in to manage your tasks
        </MudText>

        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField @bind-Value="username"
                          Label="Username"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Username is required"
                          Class="mb-4" />

            <MudTextField @bind-Value="password"
                          Label="Password"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="Password is required"
                          Class="mb-4" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="HandleLogin"
                       Disabled="@(!success || isLoading)">
                @if (isLoading)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    <MudText>Signing in...</MudText>
                }
                else
                {
                    <MudText>Sign In</MudText>
                }
            </MudButton>
        </MudForm>

        <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-4">
            Demo: Use any username/password
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    MudForm form;
    bool success;
    bool isLoading;
    string username = "";
    string password = "";

    private async Task HandleLogin()
    {
        isLoading = true;
        await Task.Delay(500); // Simulate API call

        // For demo purposes, just navigate to tasks
        // In production, call your auth API here
        Snackbar.Add("Login successful!", Severity.Success);
        Navigation.NavigateTo("/tasks");

        isLoading = false;
    }
}